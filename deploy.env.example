# Copy to deploy.env and fill in. Environment variables override these values.
# deploy.env is gitignored. Keep secrets (CF_API_TOKEN) out of git: prefer exporting them in your shell.

# Cloudflare API token (permissions: see README). If unset, deploy.sh sends no auth header,
# which only works where a proxy injects it (e.g. a Claude cloud environment network secret for api.cloudflare.com).
# CF_API_TOKEN=

# Account ID. Optional: auto-detected when the token can see exactly one account.
# CF_ACCOUNT_ID=

# Names of the Worker and the D1 database (defaults shown).
# WORKER_NAME=claude-memory
# D1_NAME=claude-memory

# Custom domain for the Worker, e.g. memory.example.com. The zone must be on the same account.
# Leave empty to use the workers.dev URL (the admin UI then stays disabled: Access needs a hostname you control).
# HOST=memory.example.com

# Cloudflare Access (admin UI). Both are needed to enable /admin; see README.
# ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# ACCESS_AUD=

# Optional: SHA-256 hex of an access token you generated yourself.
# If unset, deploy.sh generates a token, prints it once, and keeps only the hash in .token_sha256.
# TOKEN_SHA256=
