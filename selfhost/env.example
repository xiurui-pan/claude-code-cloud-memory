# Copy to selfhost/.env (gitignored) and fill in. Generate values with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"      -> a token
#   printf %s "<token>" | sha256sum | cut -d' ' -f1                   -> its SHA-256 hash

# Required. SHA-256 hex of the sync token (the one you store as the network secret).
TOKEN_SHA256=

# Admin UI login. SHA-256 hex of a second, different token that you type into the login form.
ADMIN_TOKEN_SHA256=

# Alternative to ADMIN_TOKEN_SHA256 (set only one): trust an identity header set by a reverse proxy
# that authenticates users itself and strips this header from client requests, e.g. X-Forwarded-User.
ADMIN_TRUST_PROXY_HEADER=

# Optional random string (16+ chars) so admin logins survive restarts.
ADMIN_SESSION_SECRET=

# Public origin, e.g. https://memory.example.com . Required for the admin UI behind a TLS proxy.
PUBLIC_URL=

# Only for trying the admin login over plain http://localhost: set to 0 so the cookie is not Secure.
# ADMIN_COOKIE_SECURE=0
